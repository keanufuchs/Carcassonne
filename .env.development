# Frontend (Vite dev server)
# http://localhost:5173

# Multiplayer API — leer = Same-Origin über Vite-Proxy (/api → :3001).
# Leer lassen, damit LAN-Clients den Host (nicht ihr eigenes localhost) erreichen.
VITE_API_URL=

# Multiplayer WebSocket — leer = aus aktuellem Origin abgeleitet (host:3001).
# Nur setzen, wenn der WS-Server unter einer festen Adresse läuft.
VITE_WS_URL=

# Game server port (npm run server)
PORT=3001

# MCP AI server port (npm run mcp)
MCP_PORT=3002
