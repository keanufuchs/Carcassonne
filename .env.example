# ── URLs ────────────────────────────────────────────────────────────────────
#
# Lokal:
#   Frontend   http://localhost:5173        (npm run dev)
#   API + WS   http://localhost:3001        (npm run server / npm run dev:full)
#   MCP AI     http://localhost:3002        (npm run mcp)
#
# Production (Vercel):
#   Frontend + API   https://carcasonne.vercel.app
#
# ── Multiplayer (EW-01) ─────────────────────────────────────────────────────

# REST-API-Basis-URL — leer lassen für Same-Origin (Vite-Proxy /api → :3001).
# Nur setzen, wenn die API unter einer festen, abweichenden Adresse läuft.
VITE_API_URL=

# WebSocket — leer = aus aktuellem Origin abgeleitet (host:3001), LAN-tauglich.
# Auf Vercel weglassen (automatisch HTTP-Polling).
VITE_WS_URL=

# ── Server (nur lokal) ──────────────────────────────────────────────────────

PORT=3001
MCP_PORT=3002

# Vercel Blob — wird automatisch gesetzt, wenn Blob Store im Dashboard angelegt ist
# BLOB_READ_WRITE_TOKEN=

# ── Intelligente KI (EW-02) ─────────────────────────────────────────────────
# Zwei Wege — nur einen aktivieren. Modell muss Tool Use / Function Calling
# unterstützen.

# Option A: Beliebiger OpenAI-kompatibler Endpoint (hat Vorrang)
# VITE_AI_BASE_URL=https://api.ai.rh-koeln.de/v1
# VITE_AI_API_KEY=
# Modelle, die im Setup-Bildschirm bei "Reasoning AI" auswählbar sind
# (komma-separiert). Beispiel für den RH-Köln-Endpoint:
# VITE_AI_MODELS=openai-gpt-oss-120b,gemma-4-31b-it,qwen3.6-35b-a3b

# Option B: OpenRouter — https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-ab...

# Auswählbare Modelle in der UI (komma-separiert). Das erste ist Standard.
VITE_AI_MODELS=openai/gpt-oss-120b:free,anthropic/claude-sonnet-4-6

# Optional: einzelnes Standard-/Override-Modell (wird der Liste vorangestellt)
# VITE_AI_MODEL=openai/gpt-oss-120b:free
