# ── URLs ────────────────────────────────────────────────────────────────────
#
# Lokal:
#   Frontend   http://localhost:5173        (npm run dev)
#   API + WS   http://localhost:3001        (npm run server / npm run dev:full)
#   MCP AI     http://localhost:3002        (npm run mcp)
#
# Production (Vercel):
#   Frontend + API   https://carcasonne.vercel.app
#
# ── Multiplayer (EW-01) ─────────────────────────────────────────────────────

# REST-API-Basis-URL — leer lassen für Same-Origin (Vite-Proxy /api → :3001).
# Nur setzen, wenn die API unter einer festen, abweichenden Adresse läuft.
VITE_API_URL=

# WebSocket — leer = aus aktuellem Origin abgeleitet (host:3001), LAN-tauglich.
# Auf Vercel weglassen (automatisch HTTP-Polling).
VITE_WS_URL=

# ── Server (nur lokal) ──────────────────────────────────────────────────────

PORT=3001
MCP_PORT=3002

# Vercel Blob — wird automatisch gesetzt, wenn Blob Store im Dashboard angelegt ist
# BLOB_READ_WRITE_TOKEN=

# ── Intelligente KI (EW-02) — SERVER-ONLY ───────────────────────────────────
# Modell muss Tool Use / Function Calling unterstützen.
#
# WICHTIG: Diese Variablen sind NICHT mit VITE_ präfixiert und werden daher von
# Vite NICHT in das Client-Bundle eingebettet. Der API-Key bleibt ausschließlich
# auf dem Server (server/aiService.ts). Der Client schickt den Spielzustand an
# POST /api/ai/move; der LLM-Aufruf erfolgt serverseitig.

# OpenAI-kompatibler Endpoint (z. B. RH-Köln-Endpoint)
AI_BASE_URL=https://api.ai.rh-koeln.de/v1
AI_API_KEY=

# Auswählbare Modelle (komma-separiert). Das erste ist Standard.
AI_MODELS=openai-gpt-oss-120b,gemma-4-31b-it,qwen3.6-35b-a3b

# Modell-Liste für das Setup-Dropdown im Client. NICHT sensibel (nur Namen),
# darf daher VITE_-präfixiert bleiben. Das erste ist Standard.
VITE_AI_MODELS=openai-gpt-oss-120b,gemma-4-31b-it,qwen3.6-35b-a3b
